# OSS Bucket 或绑定 CDN 后的公开访问地址，不要填写 AccessKey。
# 示例：https://static.example.com/learning-report/assets
VITE_ASSET_BASE_URL=

# 生产环境必须设置为至少 32 字节的随机值，用于签署教师登录会话。
SESSION_SECRET=

# 生产服务必须使用 production，登录 Cookie 才会启用 Secure。
NODE_ENV=production

# json 用于本地演示；正式部署使用 mysql。
DATA_BACKEND=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=learning_report
DB_PASSWORD=
DB_NAME=learning_report
DB_CONNECTION_LIMIT=8
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# 仅首次建表或受控升级时临时开启；日常生产运行保持 false。
DB_AUTO_MIGRATE=false
